\subsection*{Suggested docker-compose.yml Skeleton (high-level)}

\begin{verbatim}
version: '3.8'

services:
  relay:
    image: parity/polkadot:v1.15.0
    command: --dev --tmp --rpc-external --ws-external --rpc-cors all
    ports:
      - "9944:9944"
      - "9933:9933"

  para-a-collator:
    image: parity/polkadot-parachain:v1.15.0
    command: --alice --collator --chain ./chainspecs/para-a.json
            --base-path /data --port 40333 --ws-port 9946
            --rpc-port 9935 -- --chain rococo-local
    depends_on:
      - relay
    ports:
      - "9946:9946"
      - "9935:9935"

  mock-bridge:
    build: ./bridge-simulator
    ports:
      - "9950:9950"
      - "9951:9951"

  prometheus:
    image: prom/prometheus:latest
    ports:
      - "9090:9090"

  grafana:
    image: grafana/grafana:latest
    ports:
      - "3000:3000"
\end{verbatim}

