\section{Ethical Considerations}

\subsection{Participant Protection}

\begin{itemize}
    \item Informed consent obtained from all interview and testing participants
    \item Right to withdraw at any time without consequence
    \item No collection of personally identifiable information beyond demographics
    \item Data anonymisation before analysis
\end{itemize}

\subsection{Research Integrity}

\begin{itemize}
    \item All test scenarios documented and reproducible
    \item Raw data preserved for verification
    \item Negative or unexpected results reported transparently
    \item Limitations explicitly acknowledged
\end{itemize}

\subsection{Institutional Compliance}

\begin{itemize}
    \item Ethics approval obtained from University of Malta (if required)
    \item GDPR compliance for any EU participant data
    \item Open-source code release for community verification
\end{itemize}

