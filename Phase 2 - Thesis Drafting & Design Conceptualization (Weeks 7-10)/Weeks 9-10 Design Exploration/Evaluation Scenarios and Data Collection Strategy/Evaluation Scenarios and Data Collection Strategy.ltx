\section{Evaluation Scenarios}

\subsection{Category A: Cross-Chain Functionality (RO1)}

\subsubsection{ES-01: Basic XCM Transfer Success Rate}

\textbf{Objective:} Assess the success rate and finality duration of XCM messages that transmit rights metadata between parachains.

\textbf{Scenario Description:}
\begin{itemize}
    \item Initiate 100 XCM transfers from CCRMS parachain to Asset Hub
    \item Each transfer carries a simulated rights token with metadata (expiration, royalty config)
    \item Vary payload sizes: minimal (256 bytes), standard (1 KB), maximum (4 KB)
\end{itemize}

\begin{table}[H]
\centering
\caption{ES-01 Test Parameters}
\begin{tabularx}{\textwidth}{lL}
\toprule
\textbf{Parameter} & \textbf{Values} \\
\midrule
Number of transfers & 100 per payload size (300 total) \\
Payload sizes & 256 B, 1 KB, 4 KB \\
Network conditions & Normal, congested (simulated) \\
Repetitions & 3 runs per configuration \\
\bottomrule
\end{tabularx}
\end{table}

\textbf{Data to Collect:} Success/failure status for each transfer; time from send to confirmation (finality time); error types for failed transfers; gas/weight consumed per transfer.

\textbf{Expected Outputs:} Success rate percentage per configuration; mean, median, and standard deviation of finality times; failure mode classification.

\subsubsection{ES-02: Scheduled XCM Renewal Accuracy}

\textbf{Objective:} Evaluate the reliability and timing accuracy of scheduled XCM messages for subscription auto-renewal.

\textbf{Scenario Description:}
\begin{itemize}
    \item Schedule 50 subscription renewals at specific future block heights
    \item Block height intervals: 10 blocks, 100 blocks, 1000 blocks ahead
    \item Measure actual execution time vs. scheduled time
\end{itemize}

\begin{table}[H]
\centering
\caption{ES-02 Test Parameters}
\begin{tabularx}{\textwidth}{lL}
\toprule
\textbf{Parameter} & \textbf{Values} \\
\midrule
Number of scheduled renewals & 50 per interval (150 total) \\
Scheduling intervals & 10, 100, 1000 blocks \\
Pre-authorised balance states & Sufficient, insufficient, exact \\
\bottomrule
\end{tabularx}
\end{table}

\textbf{Data to Collect:} Scheduled block height vs. actual execution block; timing deviation (blocks early/late); success rate based on balance availability; behaviour during chain congestion.

\textbf{Expected Outputs:} Scheduling accuracy metrics (deviation distribution); renewal success rate by balance state; identified edge cases and failure modes.

\subsubsection{ES-03: Cross-Chain Royalty Distribution}

\textbf{Objective:} Measure the reliability and latency of multi-recipient royalty distributions across chains.

\textbf{Scenario Description:}
\begin{itemize}
    \item Simulate secondary sale triggering royalty distribution
    \item Recipients distributed across: CCRMS parachain (2), Asset Hub (2), external chain simulation (1)
    \item Vary royalty split complexity: 2, 5, 10 recipients
\end{itemize}

\begin{table}[H]
\centering
\caption{ES-03 Test Parameters}
\begin{tabularx}{\textwidth}{lL}
\toprule
\textbf{Parameter} & \textbf{Values} \\
\midrule
Number of test sales & 30 per split configuration (90 total) \\
Recipient counts & 2, 5, 10 \\
Recipient locations & Mixed (local + cross-chain) \\
\bottomrule
\end{tabularx}
\end{table}

\textbf{Data to Collect:} Time from sale to all royalties received; per-recipient delivery success/failure; total gas cost for distribution; partial failure handling behaviour.

\textbf{Expected Outputs:} End-to-end royalty distribution time by complexity; success rate per recipient location type; cost scaling analysis.

\subsection{Category B: Access Verification Performance (RO2)}

\subsubsection{ES-04: Subscription Access Verification Latency}

