\subsection{Qualitative Data Collection}

\subsubsection{Expert Interviews}

\textbf{Participants:} 5--10 blockchain developers/researchers with Polkadot/Kusama experience

\textbf{Recruitment:} Polkadot forums, academic networks, Web3 developer communities

\textbf{Interview Protocol:}
\begin{itemize}
    \item Semi-structured format (45--60 minutes)
    \item Topics: Architecture review, feasibility assessment, improvement suggestions
    \item Recording: Audio with consent, transcribed for analysis
\end{itemize}

\textbf{Sample Questions:}
\begin{enumerate}
    \item How does the RMRK 2.0 + scheduled XCM approach compare to alternatives you've seen?
    \item What potential issues do you foresee with the unified rights token model?
    \item How would you assess the production-readiness of this architecture?
\end{enumerate}

\subsubsection{User Testing Sessions}

\textbf{Participants:} 20--30 users (mix of content creators and consumers)

\textbf{Session Structure:}
\begin{enumerate}
    \item Pre-test questionnaire (demographics, Web3 experience)
    \item Guided task completion (subscribe, PPV purchase, ownership transfer)
    \item Think-aloud protocol during tasks
    \item Post-test questionnaire (usability, satisfaction)
    \item Semi-structured debrief interview
\end{enumerate}

\begin{table}[H]
\centering
\caption{User Testing Tasks}
\begin{tabularx}{\textwidth}{lLL}
\toprule
\textbf{Task ID} & \textbf{Description} & \textbf{Monetisation Model} \\
\midrule
UT-01 & Subscribe to content for 30 days & Subscription \\
UT-02 & Purchase 5-view pack and consume 2 views & PPV \\
UT-03 & Buy content permanently & Purchase \\
UT-04 & Transfer owned content to different wallet & Ownership transfer \\
UT-05 & Upgrade from subscription to ownership & Model transition \\
\bottomrule
\end{tabularx}
\end{table}

\subsubsection{Usability Questionnaires}

\textbf{Instrument:} System Usability Scale (SUS) + custom questions

\textbf{SUS Questions:} Standard 10-item scale, scored 0--100, industry benchmark \textasciitilde{}68.

\textbf{Custom Questions (5-point Likert scale):}
\begin{enumerate}
    \item The process of subscribing to content was straightforward.
    \item I understood how my PPV views were being tracked.
    \item I felt confident that my ownership rights were secure.
    \item The cross-chain transfer process was clear.
    \item I would use this system for real content purchases.
\end{enumerate}

